# Shared configuration for every node. Per-node identity (SHC_NODE_ID,
# SHC_ADVERTISE_ADDR) is set in docker-compose.yml. No secrets are required.

# Membership
SHC_SEEDS=node1:7000,node2:7000,node3:7000
SHC_LISTEN_ADDR=:7000
SHC_ADMIN_ADDR=:8000

# Replication and consistency
SHC_REPLICATION_FACTOR=3
# 0 = majority of the replication factor (2 of 3)
SHC_WRITE_QUORUM=0
# one | quorum
SHC_READ_CONSISTENCY=one
SHC_VNODES=128

# Memory and expiry
SHC_MAX_MEMORY_BYTES=67108864
SHC_MAX_ENTRIES=0
# lru | lfu
SHC_EVICTION=lru
SHC_TOMBSTONE_TTL=60s
SHC_SWEEP_INTERVAL=1s
SHC_MAX_KEY_BYTES=512
SHC_MAX_VALUE_BYTES=1048576
SHC_MAX_FRAME_BYTES=4194304

# Failure detection and healing
SHC_HEARTBEAT_INTERVAL=500ms
SHC_SUSPECT_AFTER=1500ms
SHC_DEAD_AFTER=4s
# 0 disables automatic removal of long-dead members
SHC_REMOVE_DEAD_AFTER=30s
SHC_ANTI_ENTROPY_INTERVAL=30s
SHC_SYNC_RATE_KEYS=20000
SHC_SYNC_BATCH=256
SHC_JOIN_TIMEOUT=30s

# Requests
SHC_REQUEST_TIMEOUT=2s
SHC_REJECT_WHEN_MINORITY=true

# Operations
# Enables POST /admin/faults. Never enable on an exposed deployment.
SHC_ENABLE_FAULT_INJECTION=true
SHC_LEAVE_ON_SHUTDOWN=false
SHC_LOG_LEVEL=info
SHC_LOG_FORMAT=json
